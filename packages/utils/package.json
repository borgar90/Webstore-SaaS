{
  "name": "@bfs/utils",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react/index.ts --format esm,cjs --dts --tsconfig tsconfig.json",
    "dev": "tsup src/index.ts src/react/index.ts --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.22",
    "@types/react": "^18.2.24",
    "eslint": "^8.57.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  }
}
